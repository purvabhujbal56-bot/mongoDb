<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your chat</title>
</head>
<body>
    <h3>edit your chat: <%= Chat._id %></h3>
    <p>This chat was sent from <br> <%= Chat.from %> to <br><%= Chat.to %></p>
    <form >
        <textarea name="msg" rows="10" cols="50"><%= Chat.msg %></textarea>
        <button>Edit</button>
    </form>
</body>
</html>